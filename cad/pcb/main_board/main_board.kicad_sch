	(text "RM0368 details Clock Registers + Clock Tree\nHSE needed for USB\n\nHSE/PLLM * PLLN/PLLQ = 48 MHz\n192 <= PLLN <= 432\n2 <= PLLQ <= 15\n2 <= PLLM <= 63\n\n\n16 MHz / 16 (PLLM = 8) = 1 MHz\n2 MHz * 192 (PLLN = 192) = 192 MHz\n192 MHz / 4 (PLLQ = 4) = 48 MHz"
		(exclude_from_sim no)
		(at 53.34 107.95 0)
		(effects
